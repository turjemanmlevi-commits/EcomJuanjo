{%- if section.blocks.size > 0 -%}
  <div class="announcement-bar" data-announcement data-speed="{{ section.settings.speed }}">
    <div class="page-width">
      <div class="announcement-bar__slider">
        {%- for block in section.blocks -%}
          <div class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="announcement-bar__text" href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span class="announcement-bar__text">{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "max_blocks": 5,
  "settings": [
    { "type": "range", "id": "speed", "label": "Cambiar cada", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anuncio",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Spedizione gratuita su tutti gli ordini" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ]
}
{% endschema %}
