<div class="page-content">
  <div class="page-width page-width--narrow">
    <header class="section-header">
      <h1 class="section-header__title">{{ page.title }}</h1>
    </header>

    {%- if page.content != blank -%}
      <div class="rte contact-intro">{{ page.content }}</div>
    {%- endif -%}

    {%- form 'contact', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" role="status">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="form-row">
        <div class="form-field">
          <label for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
          <input type="text" id="ContactName-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name }}">
        </div>
        <div class="form-field">
          <label for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
          <input type="email" id="ContactEmail-{{ section.id }}" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
        </div>
      </div>
      <div class="form-field">
        <label for="ContactPhone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
        <input type="tel" id="ContactPhone-{{ section.id }}" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
      </div>
      <div class="form-field">
        <label for="ContactBody-{{ section.id }}">{{ 'contact.message' | t }} <span aria-hidden="true">*</span></label>
        <textarea id="ContactBody-{{ section.id }}" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </div>
      <button type="submit" class="btn">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Formulario de contacto"
}
{% endschema %}
