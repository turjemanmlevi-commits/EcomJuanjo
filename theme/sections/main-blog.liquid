<div class="page-content">
  <div class="page-width">
    <header class="section-header">
      <h1 class="section-header__title">{{ blog.title }}</h1>
    </header>
    {%- paginate blog.articles by 12 -%}
      <div class="grid collection-grid" style="--columns: 3">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}
            {%- endif -%}
            <div class="list-collections__title">{{ article.title }}</div>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="pagination">{{ paginate | default_pagination }}</div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog"
}
{% endschema %}
