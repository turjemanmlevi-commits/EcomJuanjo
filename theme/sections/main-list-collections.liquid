<div class="page-content">
  <div class="page-width">
    <header class="section-header">
      <h1 class="section-header__title">{{ 'general.collections' | t }}</h1>
    </header>
    <div class="grid collection-grid">
      {%- for collection in collections -%}
        {%- assign category_asset = '' -%}
        {%- case collection.handle -%}
          {%- when 'abbigliamento' -%}{%- assign category_asset = 'category-clothing.webp' -%}
          {%- when 'borse' -%}{%- assign category_asset = 'category-bags.webp' -%}
          {%- when 'scarpe' -%}{%- assign category_asset = 'category-shoes.webp' -%}
        {%- endcase -%}
        <a href="{{ collection.url }}">
          <div class="grid__image-ratio">
            {%- if category_asset != blank -%}
              <img src="{{ category_asset | asset_url }}" loading="lazy" width="1122" height="1402" alt="{{ collection.title | escape }}">
            {%- elsif collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="list-collections__title">{{ collection.title }}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lista de colecciones"
}
{% endschema %}
