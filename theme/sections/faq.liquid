{%- liquid
  assign filled = 0
  for block in section.blocks
    if block.settings.answer != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}

{%- if filled > 0 or request.design_mode -%}
<div class="index-section">
  <div class="page-width page-width--narrow">
    {%- if section.settings.title != blank -%}
      <header class="section-header">
        <h2 class="section-header__title">{{ section.settings.title | escape }}</h2>
      </header>
    {%- endif -%}

    <div class="faq__list">
    {%- for block in section.blocks -%}
      {%- if block.settings.answer == blank -%}
        {%- if request.design_mode -%}
          <p class="editor-hint" {{ block.shopify_attributes }}>«{{ block.settings.question | escape }}» no tiene respuesta y no se muestra en la tienda.</p>
        {%- endif -%}
        {%- continue -%}
      {%- endif -%}
      <div class="faq__item" {{ block.shopify_attributes }}>
        <button
          type="button"
          class="collapsible-trigger collapsible-trigger--inline"
          aria-controls="FAQ-{{ block.id }}"
          aria-expanded="false"
        >
          <span class="collapsible-trigger__icon collapsible-trigger__icon--circle">{% render 'icon', name: 'chevron-down' %}</span>
          <span>{{ block.settings.question | escape }}</span>
        </button>
        <div id="FAQ-{{ block.id }}" class="collapsible-content">
          <div>
            <div class="collapsible-content__inner--faq rte">{{ block.settings.answer }}</div>
          </div>
        </div>
      </div>
    {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Preguntas frecuentes",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Domande frequenti" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "Quanto tempo richiede la spedizione?" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "info": "Las preguntas sin respuesta no se muestran." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Preguntas frecuentes",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
