<div class="page-content">
  <div class="page-width page-width--narrow">
    <header class="section-header">
      <h1 class="section-header__title">{{ article.title }}</h1>
    </header>
    {%- if article.image -%}
      <div style="margin-bottom: 30px">{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: article.title }}</div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Artículo"
}
{% endschema %}
