{%- liquid
  assign filled = 0
  for block in section.blocks
    if block.settings.text != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}

{%- if filled > 0 or request.design_mode -%}
{%- style -%}
  #shopify-section-{{ section.id }} .testimonials {
    --testimonials-bg: {{ section.settings.color_bg }};
    {%- if section.settings.color_stars != blank %}--star-color: {{ section.settings.color_stars }};{% endif %}
  }
{%- endstyle -%}

<div class="testimonials" data-testimonials>
  <div class="testimonials__inner">
    <div class="testimonials__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="testimonials__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="testimonials__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}
      {%- if filled > 1 -%}
        <div class="testimonials__nav">
          <button type="button" data-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
          <button type="button" data-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      {%- endif -%}
    </div>

    <div class="testimonials__slider">
      {%- for block in section.blocks -%}
        {%- if block.settings.text == blank -%}
          {%- if request.design_mode -%}
            <div class="testimonials__slide testimonials__slide--empty" {{ block.shopify_attributes }}>
              <p class="editor-hint">Opinión vacía: pega aquí una reseña real de una clienta. Las opiniones vacías no se muestran en la tienda.</p>
            </div>
          {%- endif -%}
          {%- continue -%}
        {%- endif -%}
        <div class="testimonials__slide" {{ block.shopify_attributes }}>
          {%- if section.settings.show_images -%}
            <div class="testimonials__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', sizes: '(min-width: 769px) 20vw, 70vw', widths: '250, 500' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="testimonials__content">
            <div class="testimonials__stars" role="img" aria-label="{{ block.settings.rating }} / 5">
              {%- for i in (1..5) -%}
                <span class="product-rating__star" style="--fill: {% if i <= block.settings.rating %}100{% else %}0{% endif %}%"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12.02 4.23 L14.01 10.40 L20.50 10.40 L15.25 14.23 L17.23 20.37 L12.02 16.54 L6.77 20.37 L8.75 14.23 L3.50 10.40 L9.99 10.40Z M15.25 14.23 L15.93 16.35 L12.02 16.54Z"/></svg></span>
              {%- endfor -%}
            </div>
            <blockquote class="testimonials__text">{{ block.settings.text }}</blockquote>
            {%- if block.settings.author != blank -%}
              <div class="testimonials__author">
                <strong>{{ block.settings.author | escape }}</strong>
                {%- if block.settings.detail != blank %} {{ block.settings.detail | escape }}{% endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Opiniones de clientes",
  "max_blocks": 14,
  "settings": [
    { "type": "paragraph", "content": "Usa solo opiniones reales de tus clientes. Las opiniones sin texto no se muestran, y si no hay ninguna la sección entera se oculta." },
    { "type": "text", "id": "heading", "label": "Título", "default": "Cosa dicono le nostre clienti" },
    { "type": "richtext", "id": "subheading", "label": "Subtítulo" },
    { "type": "checkbox", "id": "show_images", "label": "Mostrar foto en cada opinión", "default": true },
    { "type": "color", "id": "color_bg", "label": "Fondo", "default": "#f4f3f1" },
    { "type": "color", "id": "color_stars", "label": "Color de las estrellas", "info": "Vacío = color de acento del tema." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Opinión",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "range", "id": "rating", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "richtext", "id": "text", "label": "Texto", "info": "Máximo 2-3 líneas: un extracto corto se lee mejor." },
        { "type": "text", "id": "author", "label": "Nombre" },
        { "type": "text", "id": "detail", "label": "Detalle (ciudad, fecha)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Opiniones de clientes",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
