{%- liquid
  assign filled = 0
  for block in section.blocks
    if block.settings.text != blank
      assign filled = filled | plus: 1
    endif
  endfor
  assign slide_count = filled
  if request.design_mode
    assign slide_count = section.blocks.size
  endif
-%}

{%- if filled > 0 or request.design_mode -%}
{%- style -%}
  #shopify-section-{{ section.id }} .testimonials {
    --testimonials-bg: {{ section.settings.color_bg }};
    {%- if section.settings.color_stars != blank %}--star-color: {{ section.settings.color_stars }};{% endif %}
  }
{%- endstyle -%}

<div
  class="testimonials"
  data-testimonials
  {% if section.settings.autoplay and slide_count > 1 %}data-autoplay="{{ section.settings.autoplay_speed }}"{% endif %}
  role="region"
  aria-roledescription="carousel"
  {% if section.settings.heading != blank %}aria-labelledby="Testimonials-{{ section.id }}"{% else %}aria-label="{{ 'general.reviews' | t }}"{% endif %}
>
  <div class="testimonials__inner">
    <div class="testimonials__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="testimonials__heading" id="Testimonials-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="testimonials__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    {%- if slide_count > 1 -%}
      <div class="testimonials__controls">
        <div class="testimonials__progress" data-progress aria-hidden="true"><span></span></div>
        {%- if section.settings.autoplay -%}
          <button
            type="button"
            class="testimonials__toggle"
            data-autoplay-toggle
            aria-label="{{ 'general.pause' | t }}"
            data-label-pause="{{ 'general.pause' | t }}"
            data-label-play="{{ 'general.play' | t }}"
          >
            <span class="testimonials__icon-pause">{% render 'icon', name: 'pause' %}</span>
            <span class="testimonials__icon-play">{% render 'icon', name: 'play' %}</span>
          </button>
        {%- endif -%}
        <div class="testimonials__nav">
          <button type="button" data-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
          <button type="button" data-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      </div>
    {%- endif -%}

    <div class="testimonials__slider" tabindex="0">
      {%- assign n = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
        {%- assign n = n | plus: 1 -%}
        {%- if block.settings.text == blank -%}
          <div class="testimonials__slide testimonials__slide--empty" role="group" aria-roledescription="slide" aria-label="{{ n }} / {{ slide_count }}" {{ block.shopify_attributes }}>
            <div class="testimonials__card">
              <p class="editor-hint">Opinión vacía: pega aquí una reseña real de una clienta. Las opiniones vacías no se muestran en la tienda.</p>
            </div>
          </div>
          {%- continue -%}
        {%- endif -%}
        <div class="testimonials__slide" role="group" aria-roledescription="slide" aria-label="{{ n }} / {{ slide_count }}" {{ block.shopify_attributes }}>
          <div class="testimonials__card">
            {%- if section.settings.show_images -%}
              <div class="testimonials__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', draggable: 'false', sizes: '(min-width: 769px) 330px, 74vw', widths: '330, 500, 700, 900' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="testimonials__content">
              <div class="testimonials__stars" role="img" aria-label="{{ block.settings.rating }} / 5">
                {%- for i in (1..5) -%}
                  <span class="product-rating__star" style="--fill: {% if i <= block.settings.rating %}100{% else %}0{% endif %}%"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12.02 4.23 L14.01 10.40 L20.50 10.40 L15.25 14.23 L17.23 20.37 L12.02 16.54 L6.77 20.37 L8.75 14.23 L3.50 10.40 L9.99 10.40Z M15.25 14.23 L15.93 16.35 L12.02 16.54Z"/></svg></span>
                {%- endfor -%}
              </div>
              <blockquote class="testimonials__text">{{ block.settings.text }}</blockquote>
              {%- if block.settings.author != blank -%}
                <div class="testimonials__author">
                  <strong>{{ block.settings.author | escape }}</strong>
                  {%- if block.settings.detail != blank %} <span>{{ block.settings.detail | escape }}</span>{% endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Opiniones de clientes",
  "max_blocks": 14,
  "settings": [
    { "type": "paragraph", "content": "Usa solo opiniones reales de tus clientes. Las opiniones sin texto no se muestran, y si no hay ninguna la sección entera se oculta." },
    { "type": "text", "id": "heading", "label": "Título", "default": "Cosa dicono le nostre clienti" },
    { "type": "richtext", "id": "subheading", "label": "Subtítulo" },
    { "type": "checkbox", "id": "show_images", "label": "Mostrar foto en cada opinión", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "Girar la rueda sola", "info": "Avanza a la siguiente opinión mientras la sección está a la vista. Se para en cuanto la clienta toca, arrastra o usa las flechas, y nunca se activa si su dispositivo pide reducir el movimiento.", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Segundos por opinión", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "color", "id": "color_bg", "label": "Fondo", "default": "#f4f3f1" },
    { "type": "color", "id": "color_stars", "label": "Color de las estrellas", "info": "Vacío = color de acento del tema." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Opinión",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "range", "id": "rating", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "richtext", "id": "text", "label": "Texto", "info": "Máximo 2-3 líneas: un extracto corto se lee mejor." },
        { "type": "text", "id": "author", "label": "Nombre" },
        { "type": "text", "id": "detail", "label": "Detalle (ciudad, fecha)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Opiniones de clientes",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
