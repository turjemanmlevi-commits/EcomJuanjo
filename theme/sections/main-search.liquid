<div class="page-content">
  <div class="page-width">
    <header class="section-header">
      <h1 class="section-header__title">
        {%- if search.performed -%}
          {{ 'general.results_for' | t: terms: search.terms }}
        {%- else -%}
          {{ 'general.search' | t }}
        {%- endif -%}
      </h1>
    </header>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}" aria-label="{{ 'general.search' | t }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn">{{ 'general.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- capture clear_url -%}{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product{%- endcapture -%}
        {% render 'facets', results: search, url: routes.search_url, count: search.results_count, clear_url: clear_url %}

        {%- if search.results_count == 0 -%}
          <p class="text-center">{{ 'general.no_results' | t: terms: search.terms }}</p>
        {%- else -%}
          <div class="grid collection-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Búsqueda"
}
{% endschema %}
