{%- style -%}
  #shopify-section-{{ section.id }} .sale-banner { --sale-banner-bg: {{ section.settings.color_bg }}; --sale-banner-text: {{ section.settings.color_text }}; }
{%- endstyle -%}

{%- if section.settings.small_text != blank or section.settings.big_text != blank -%}
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" class="sale-banner sale-banner--link">
  {%- else -%}
    <div class="sale-banner">
  {%- endif -%}
    <div class="page-width sale-banner__inner">
      {%- if section.settings.small_text != blank -%}
        <span class="sale-banner__small">{{ section.settings.small_text | escape }}</span>
      {%- endif -%}
      {%- if section.settings.big_text != blank -%}
        <span class="sale-banner__big">{{ section.settings.big_text | escape }}</span>
      {%- endif -%}
    </div>
  {%- if section.settings.link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Banner de descuento",
  "settings": [
    { "type": "text", "id": "small_text", "label": "Texto pequeño", "default": "EVERYTHING" },
    { "type": "text", "id": "big_text", "label": "Texto grande", "default": "50% OFF" },
    { "type": "url", "id": "link", "label": "Enlace", "info": "Opcional. Todo el banner se vuelve clicable.", "default": "/collections/all" },
    { "type": "color", "id": "color_bg", "label": "Fondo", "default": "#f5f2ed" },
    { "type": "color", "id": "color_text", "label": "Texto", "default": "#1c1b1a" }
  ],
  "presets": [{ "name": "Banner de descuento" }]
}
{% endschema %}
