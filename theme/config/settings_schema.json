  {
    "name": "Datos legales",
    "settings": [
      {
        "type": "paragraph",
        "content": "En Italia la web de una tienda debe mostrar la Partita IVA. Estos datos aparecen en el pie de página y en los datos estructurados para Google."
      },
      {
        "type": "text",
        "id": "legal_name",
        "label": "Razón social",
        "info": "Ej.: Oriona di Caterina Rossi"
      },
      {
        "type": "text",
        "id": "legal_vat",
        "label": "Partita IVA",
        "info": "Ej.: IT01234567890"
      },
      {
        "type": "text",
        "id": "legal_address",
        "label": "Dirección de la sede"
      },
      {
        "type": "text",
        "id": "legal_email",
        "label": "Email de contacto"
      }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Al añadir un producto",
        "options": [
          {
            "value": "drawer",
            "label": "Abrir el carrito lateral"
          },
          {
            "value": "page",
            "label": "Ir a la página del carrito"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "show_dynamic_checkout",
        "label": "Mostrar botón de compra rápida en la ficha (Shop Pay, Apple Pay, PayPal…)",
        "default": true,
        "info": "Shopify muestra los métodos que tengas activados en Pagos."
      }
    ]
  },
  {
    "name": "Búsqueda",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search",
        "label": "Mostrar resultados mientras se escribe",
        "default": true
      }
    ]
  },
  {
    "name": "Tarjetas de producto",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_card_rating",
        "label": "Mostrar estrellas en las tarjetas de producto",
        "default": true,
        "info": "Usa la valoración real de tu app de reseñas. Los productos sin reseñas no muestran estrellas."
      }
    ]
  },
  {
    "name": "Trustpilot",
    "settings": [
      {
        "type": "paragraph",
        "content": "Muestra tu valoración real de Trustpilot con el widget oficial (TrustBox). Necesitas un perfil de empresa en business.trustpilot.com: el Business Unit ID está en Integraciones > TrustBox. Mientras esté vacío, no se muestra nada."
      },
      {
        "type": "text",
        "id": "trustpilot_business_id",
        "label": "Business Unit ID"
      },
      {
        "type": "url",
        "id": "trustpilot_url",
        "label": "Enlace a tu perfil",
        "info": "Ej.: https://it.trustpilot.com/review/tutienda.it"
      },
      {
        "type": "select",
        "id": "trustpilot_template",
        "label": "Estilo del widget",
        "options": [
          {
            "value": "5419b732fbfb950b10de65e5",
            "label": "Micro Star (estrellas + nota)"
          },
          {
            "value": "5419b6a8b0d04a076446a9ad",
            "label": "Micro Review Count (nº de opiniones)"
          },
          {
            "value": "53aa8807dec7e10d38f59f36",
            "label": "Mini (logo + estrellas + total)"
          }
        ],
        "default": "5419b732fbfb950b10de65e5",
        "info": "Algunos estilos requieren un plan de pago de Trustpilot."
      },
      {
        "type": "text",
        "id": "trustpilot_locale",
        "label": "Idioma",
        "default": "it-IT"
      },
      {
        "type": "checkbox",
        "id": "trustpilot_product",
        "label": "Mostrar en la ficha de producto (bajo el botón de compra)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "trustpilot_footer",
        "label": "Mostrar en el pie de página",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "trustpilot_product_ratings",
        "label": "Mostrar el logo de Trustpilot junto a las estrellas del producto",
        "info": "Actívalo solo si esas valoraciones vienen de tu perfil de Trustpilot (reseñas de producto de Trustpilot). Si vienen de otra app, el logo sería engañoso.",
        "default": false
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Imagen del favicon"
      }
    ]
  }
]
