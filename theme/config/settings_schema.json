      },
      {
        "type": "header",
        "content": "Botones"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Botón",
        "default": "#1c1b1a"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Texto del botón",
        "default": "#faf9f7"
      },
      {
        "type": "color",
        "id": "color_buy_button",
        "label": "Botón de compra",
