[
  {
    "name": "theme_info",
    "theme_name": "Juanjo Fashion",
    "theme_version": "1.0.0",
    "theme_author": "EcommerceJuanjo",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Fuente de títulos",
        "default": "tenor_sans_n4"
      },
      {
        "type": "font_picker",
        "id": "type_base_font",
        "label": "Fuente de texto",
        "default": "outfit_n3"
      },
      {
        "type": "range",
        "id": "type_base_size",
        "label": "Tamaño del texto base",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 17
      }
    ]
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "color",
        "id": "color_body_bg",
        "label": "Fondo",
