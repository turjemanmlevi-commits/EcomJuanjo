      },
      {
        "type": "color",
        "id": "color_body_text",
        "label": "Texto",
        "default": "#1c1b1a"
      },
      {
        "type": "color",
        "id": "color_borders",
        "label": "Líneas y bordes",
        "default": "#e6e3de"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Acento (ofertas, valoración, contador del carrito)",
