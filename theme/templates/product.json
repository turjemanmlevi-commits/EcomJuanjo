      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Perché acquistare da Oriona?",
            "answer": "<p>Scegliere Oriona significa trovare capi pensati per donne reali, con stile, vestibilità curata e assistenza dedicata.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Quanto tempo richiede la spedizione?",
            "answer": "<p>La spedizione tracciata è gratuita su ogni ordine in Italia, senza minimo di spesa. Riceverai il tracking via email.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Dov’è il mio ordine?",
            "answer": "<p>Quando il tuo ordine parte, ti inviamo il numero di tracking per seguire la consegna fino alla porta.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Come funzionano i resi?",
            "answer": "<p>Hai 30 giorni dalla consegna per richiedere un reso. Scrivici e ti guideremo in modo semplice e veloce.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Quali metodi di pagamento accettate?",
            "answer": "<p>Puoi pagare in modo sicuro con Visa, Mastercard, American Express, PayPal, Apple Pay, Google Pay e Klarna.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
